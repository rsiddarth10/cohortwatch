# Copy to .env for local development. Every value has a default in docker-compose.yml,
# so a fresh clone runs with no .env at all (compose default is SIM_SCALE=100000).

# Number of simulated vehicles. Dev loop: 5000. Demo/submission: 100000.
SIM_SCALE=5000
# Global seed. Same seed + same N => identical registry and message stream.
SIM_SEED=cohortwatch-42
# Worker processes; each owns a contiguous VIN range. Output is identical for any value.
SIM_WORKERS=4
# Plants are a step-1b feature; must stay off in 1a.
PLANTS=off

# Database passwords (dev only; never reuse these anywhere real).
POSTGRES_PASSWORD=cw_postgres_dev
CW_SIM_PASSWORD=cw_sim_dev
CW_APP_PASSWORD=cw_app_dev

LOG_LEVEL=info

# Laptop disk caps for the high-volume topics (6 h retention + a byte cap per partition).
# off = production values from the brief (3 d, no byte cap). Re-run topic-init after changing.
LAPTOP_RETENTION=on
# 256 MiB per partition (Docker's disk is on D:). Use 67108864 (64 MiB) on a small disk.
KAFKA_PARTITION_BYTES=268435456
# Bench topics only: they measure throughput and keep nothing.
BENCH_PARTITION_BYTES=16777216

# Host ports (container ports are fixed). Defaults avoid clashing with a local Postgres/Redis.
PG_HOST_PORT=15432
REDIS_HOST_PORT=16379
